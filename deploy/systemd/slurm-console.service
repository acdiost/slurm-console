[Unit]
Description=Slurm Console
After=network.target

[Service]
Type=simple
User=slurm-console
Group=slurm-console
WorkingDirectory=/var/lib/slurm-console
Environment=SLURM_CONSOLE_PAM_ENABLED=true
Environment=SLURM_CONSOLE_PUBLIC_DIR=/opt/slurm-console/public
ExecStart=/opt/slurm-console/slurm-console serve --http=127.0.0.1:18090 --dir=/var/lib/slurm-console/pb_data
Restart=on-failure
RestartSec=5
UMask=0077
PrivateTmp=true
ProtectSystem=full
# sudo must elevate only the dedicated PAM helper; NoNewPrivileges would block it.

[Install]
WantedBy=multi-user.target
