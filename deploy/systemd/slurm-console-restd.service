[Unit]
Description=Local Slurm REST endpoint for Slurm Console
After=munge.service slurmctld.service

[Service]
Type=simple
User=slurm-console
Group=slurm-console
RuntimeDirectory=slurm-console-rest
RuntimeDirectoryMode=0700
UMask=0077
# Adjust executable and parser to the installed Slurm release.
ExecStart=/usr/sbin/slurmrestd -a rest_auth/local -s slurmctld -d v0.0.43 -t 2 unix:/run/slurm-console-rest/rest.sock
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
