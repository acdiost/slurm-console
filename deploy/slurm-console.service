[Unit]
Description=Slurm Console
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/var/lib/slurm-console
EnvironmentFile=-/etc/slurm-console/slurm-console.env
Environment=SLURM_CONSOLE_PUBLIC_DIR=/opt/slurm-console/public
ExecStart=/opt/slurm-console/slurm-console serve --http=127.0.0.1:18090 --dir=/var/lib/slurm-console/pb_data
Restart=on-failure
RestartSec=5
UMask=0077
PrivateTmp=true
ProtectSystem=false
# Local account tools must update the host /etc account databases.

[Install]
WantedBy=multi-user.target
