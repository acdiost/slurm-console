  "jobs": {
    "label": "作业",
    "scoped": true,
    "permissions": [
      [
        "jobs.read"
      ]
    ],
    "fields": {
      "q": {
        "type": "text",
        "max": 128
      },
      "user": {
        "type": "text",
        "max": 128
      },
      "account": {
        "type": "text",
        "max": 128
      },
      "partition": {
        "type": "text",
        "max": 255
      },
      "qos": {
        "type": "text",
        "max": 128
      },
      "state": {
        "type": "state",
        "max": 64
      },
      "sort": {
        "type": "enum",
        "values": [
          "id",
          "submitTime",
          "cpus"
        ]
      },
      "order": {
        "type": "enum",
        "values": [
          "asc",
          "desc"
        ]
      },
      "perPage": {
        "type": "enum",
        "values": [
          "20",
          "50",
          "100"
        ]
      }
    }
  },
