  "history": {
    "label": "历史作业",
    "scoped": true,
    "permissions": [
      [
        "job_history.read"
      ]
    ],
    "fields": {
      "q": {
        "type": "text",
        "max": 128
      },
      "start": {
        "type": "unix"
      },
      "end": {
        "type": "unix"
      },
      "user": {
        "type": "name",
        "max": 64
      },
      "account": {
        "type": "name",
        "max": 64
      },
      "partition": {
        "type": "name",
        "max": 64
      },
      "qos": {
        "type": "name",
        "max": 64
      },
      "state": {
        "type": "enum",
        "values": [
          "PENDING",
          "RUNNING",
          "SUSPENDED",
          "COMPLETED",
          "CANCELLED",
          "FAILED",
          "TIMEOUT",
          "NODE_FAIL",
          "PREEMPTED",
          "BOOT_FAIL",
          "DEADLINE",
          "OUT_OF_MEMORY",
          "REQUEUED",
          "REVOKED"
        ]
      },
      "jobId": {
        "type": "jobId"
      },
      "sort": {
        "type": "enum",
        "values": [
          "submitTime",
          "startTime",
          "endTime",
          "elapsedSeconds",
          "id"
        ]
      },
      "order": {
        "type": "enum",
        "values": [
          "asc",
          "desc"
        ]
      }
    }
  },
